{
  "name": "ro-toolbox-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "backend:jar": "..\\gradlew.bat -p .. bootJar",
    "backend:copy": "node scripts/copy-backend.mjs",
    "tauri:dev": "npm run backend:jar && npm run backend:copy && npx tauri dev",
    "tauri:dev:external": "set RO_TOOLBOX_EXTERNAL_BACKEND=1&&npx tauri dev",
    "tauri:build": "npm run build && npm run backend:jar && npm run backend:copy && npx tauri build"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.10"
  }
}
